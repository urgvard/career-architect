# AI inference runs through the Netlify AI Gateway by default — no API key required.
# Netlify automatically injects GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL in the
# Functions/server runtime, and the @google/genai SDK auto-detects them. Requests are
# billed to your Netlify credits with high account-level rate limits (this replaces the
# personal free-tier key whose 15 req/min + 250k tokens/min caps caused 429 errors).

# GEMINI_MODEL (optional): override the Gemini model used for all generations.
# Defaults to gemini-2.5-flash. Any model supported by the Netlify AI Gateway works.
# GEMINI_MODEL="gemini-2.5-flash"

# USER_GEMINI_API_KEY / GEMINI_API_KEY (optional): only used as a fallback when the
# AI Gateway is unavailable (e.g. a plain local `node` run without `netlify dev`).
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

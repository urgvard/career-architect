# ── AI provider ───────────────────────────────────────────────────────────
# By default the app routes all AI calls through the Netlify AI Gateway, which
# requires NO key here — Netlify injects credentials automatically and billing
# runs on your Netlify credits (no free-tier rate limits). Nothing to set.

# AI_MODEL: Single switch for the model used by every AI feature.
# Default: gemini-2.5-flash. See results.md for the recommended options.
# AI_MODEL="gemini-2.5-flash"

# AI_USE_GATEWAY: Set to "false" to bypass the gateway and use a direct
# Google Gemini key (USER_GEMINI_API_KEY) instead. Default: true.
# AI_USE_GATEWAY="true"

# USER_GEMINI_API_KEY: Optional. Only used as a fallback when the AI Gateway is
# unavailable or disabled (e.g. local development with your own Google key).
# USER_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
